{
  "name": "remixd",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/remixd/src",
  "projectType": "library",
  "implicitDependencies": ["remix-solidity"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/remixd",
        "main": "libs/remixd/src/index.ts",
        "tsConfig": "libs/remixd/tsconfig.lib.json",
        "assets": ["libs/remixd/*.md", "libs/remixd/origins.json"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": []
}
