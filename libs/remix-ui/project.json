{
    "name": "remix-ui",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/remix-ui/src",
    "projectType": "application",
    "implicitDependencies": [
    ],
    "targets": {
      "test": {
        "executor": "@nrwl/workspace:run-commands",
        "options": {
          "command": "TS_NODE_PROJECT=libs/remix-ui/run-tab-environment/tsconfig.spec.json mocha -r ts-node/register \"libs/remix-ui/run-tab-environment/test/**/*.spec.ts\"",
          "cwd": "."
        }
      },
      "lint": {
        "executor": "@nrwl/linter:eslint",
        "outputs": ["{options.outputFile}"],
        "options": {
          "lintFilePatterns": ["libs/remix-ui/**/*.{ts,tsx,js,jsx}"],
          "eslintConfig": "libs/remix-ui/.eslintrc"
        }
      }
    },
    "tags": []
  }
  